textbox-custom {
    background-color:            inherit;
    text-color:                  @foreground;
    vertical-align:              0;
    horizontal-align:            0.5;
    placeholder-color:           @foreground;
    blink:                       true;
    markup:                      true;
    content: "shutdown[X] logout[E] reboot[R] suspend[S} lock[L]";
    expand: false;
}
